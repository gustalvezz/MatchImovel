{
  "name": "matchimovel-video",
  "version": "1.0.0",
  "private": true,
  "description": "Apresentações do MatchImovel em motion design (Remotion)",
  "scripts": {
    "dev": "remotion studio",
    "render:corretor": "remotion render Corretor out/matchimovel-corretor.mp4",
    "render:comprador": "remotion render Comprador out/matchimovel-comprador.mp4",
    "render": "npm run render:corretor && npm run render:comprador",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@react-three/fiber": "^9.8.1",
    "@remotion/cli": "4.0.534",
    "@remotion/three": "4.0.534",
    "@remotion/transitions": "4.0.534",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "4.0.534",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "typescript": "^5.9.3"
  }
}
